    <body>
      <chapter eId="chp_1"><num>1 luku</num><heading>Yleiset säännökset</heading>
        <section eId="chp_1__sec_1v20200010" finlex:originalVersion="@20200010"><num>1 §</num><heading>Koeaika</heading>
          <subsection eId="s1"><content><p>Koeaika voi olla enintään kuusi kuukautta.</p></content></subsection>
          <subsection eId="s2"><content><p>Koeaikaa voidaan pidentää sairauden vuoksi.</p></content></subsection>
        </section>
        <section eId="chp_1__sec_1v20300005" finlex:originalVersion="@20300005"><num>1 §</num><heading>Koeaika</heading>
          <subsection eId="s1b"><content><p>Koeaika voi olla enintään neljä kuukautta.</p></content></subsection>
        </section>
        <section eId="chp_1__sec_2"><num>2 §</num><content><p>2 § on kumottu L:lla 1.1.2019/1.</p></content></section>
